    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^25.0.1",
    "msw": "^2.4.10",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8",
    "vitest": "^2.1.2",
    "@vitest/coverage-v8": "^2.1.2"
